# JagaNVR - lightweight NVR, systemd unit.
#
# 1. Edit the paths below to match your install location.
# 2. Copy and enable:
#      sudo cp jaganvr.service /etc/systemd/system/
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now jaganvr
#      systemctl status jaganvr
#      journalctl -u jaganvr -f

[Unit]
Description=JagaNVR lightweight NVR
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# --- EDIT THESE to match your install ---
# If you cloned to /root/jaganvr, change /opt/jaganvr below.
WorkingDirectory=/opt/jaganvr
ExecStart=/opt/jaganvr/.venv/bin/python /opt/jaganvr/run.py serve
# If your storage_root is under /home, uncomment:
# ReadWritePaths=/home

# Optional: run as dedicated user (create with: useradd -r -s /usr/sbin/nologin jaganvr)
# User=jaganvr
# Group=jaganvr

# SIGTERM makes run.py call app.shutdown(), which writes `q` to each ffmpeg's
# stdin so the MKV trailer gets written. Do NOT use KillSignal=SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=jaganvr

[Install]
WantedBy=multi-user.target
