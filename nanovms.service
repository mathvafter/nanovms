# NanoVMS - lightweight NVR, systemd unit.
#
# 1. Edit the paths below to match your install location.
# 2. Copy and enable:
#      sudo cp nanovms.service /etc/systemd/system/
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now nanovms
#      systemctl status nanovms
#      journalctl -u nanovms -f

[Unit]
Description=NanoVMS lightweight NVR
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# --- EDIT THESE to match your install ---
# If you cloned to /root/nanovms, change /opt/nanovms below.
WorkingDirectory=/opt/nanovms
ExecStart=/opt/nanovms/.venv/bin/python /opt/nanovms/run.py serve
# If your storage_root is under /home, uncomment:
# ReadWritePaths=/home

# Optional: run as dedicated user (create with: useradd -r -s /usr/sbin/nologin nanovms)
# User=nanovms
# Group=nanovms

# SIGTERM makes run.py call app.shutdown(), which writes `q` to each ffmpeg's
# stdin so the MKV trailer gets written. Do NOT use KillSignal=SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nanovms

[Install]
WantedBy=multi-user.target
